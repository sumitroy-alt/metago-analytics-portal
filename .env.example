# ── MetaGo Central Auth (OIDC) ──────────────────────────────
# Auth service issuer (confirmed live via /.well-known/openid-configuration)
OIDC_ISSUER=https://one.metago.health

# THIS app's client id, registered with MetaGo Central Auth.
# This is also the token `aud` the SDK checks. Ask whoever runs `metago-auth`
# to register the dashboard app and give you this id (e.g. "analytics" / "dashboards").
OIDC_CLIENT_ID=REPLACE_WITH_REGISTERED_CLIENT_ID

# Only set if the auth team registered us as a CONFIDENTIAL client.
# For a public (PKCE) client leave this blank.
OIDC_CLIENT_SECRET=

# Space-separated scopes for user login. Confirm with the auth team —
# discovery advertises "mcp"; a browser login typically wants openid/profile/email.
OIDC_SCOPE=openid profile email

# ── App ─────────────────────────────────────────────────────
# Public base URL of THIS app. The callback below must be whitelisted
# in the client registration.  Locally: http://localhost:3000
APP_URL=http://localhost:3000
# Derived redirect URI = ${APP_URL}/api/auth/callback  (must be whitelisted)

# 32+ char random string used to sign/encrypt the session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# Comma-separated emails that should be admins on first login (seed).
# Everyone else defaults to "user" with no dashboards until an admin grants access.
BOOTSTRAP_ADMINS=sumit.roy@ketto.org

# Restrict logins to this email domain (defense-in-depth; auth service also enforces).
ALLOWED_EMAIL_DOMAIN=metago.health
